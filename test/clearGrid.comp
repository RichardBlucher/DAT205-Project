#version 430

layout(local_size_x = 256) in;

layout(std430, binding = 4) buffer CellCounts
{
    uint cellCounts[];
};

layout(std430, binding = 6) buffer Overflow
{
    uint overflowCounter;
};


uniform uint numCells;

void main()
{
    uint id = gl_GlobalInvocationID.x;

    if(id >= numCells)
        return;

    cellCounts[id] = 0;

    overflowCounter = 0;
}