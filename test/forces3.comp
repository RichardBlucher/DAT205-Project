#version 430

layout(local_size_x = 256) in;

struct Particle
{
    vec2 position;
    vec2 velocity;
};

layout(std430, binding = 0) buffer Particles
{
    Particle particles[];
};

layout(std430, binding = 1) buffer DensityBuffer
{
    float densities[];
};

layout(std430, binding = 2) buffer PressureBuffer
{
    float pressures[];
};

layout(std430, binding = 3) buffer predPosBuffer
{
    vec2 predPos[];
};

layout(std430, binding = 4) buffer CellCounts
{
    uint cellCounts[];
};

layout(std430, binding = 5) buffer CellParticles
{
    uint cellParticles[];
};

uniform float dt;
uniform uint particleCount;

uniform float dampening;
uniform vec2 gravity;

uniform vec2 mousePos;
uniform bool mouseDown;
uniform float mouseForceRadius;
uniform float mouseForceStrength;

uniform float smoothRadius;
uniform float smoothRadiusSq;
uniform float kernelVolume;

uniform float viscosityStrength;

uniform uint gridWidth;
uniform uint gridHeight;
uniform uint MAX_PARTICLES_PER_CELL;


uniform vec2 worldMin;  
uniform vec2 worldMax;  

ivec2 PositionToCellCoord(vec2 point)
{
    vec2 shifted = point - worldMin;
    return ivec2(floor(shifted / smoothRadius));
}

float kernel(float radius, float dist)
{
    float value  = max(0.0, radius - dist);
    return value * value * value / kernelVolume;
}

float kernelDerivative(float radius, float dist)
{
    if (dist > radius) 
        return 0.0;
    return -3.0 * (radius - dist) * (radius - dist) / kernelVolume;
}



vec2 calculateMouseForce(uint i)
{
    if (!mouseDown)
        return vec2(0.0);

    vec2 offset = mousePos - predPos[i];
    float dist  = length(offset);

    if (dist > mouseForceRadius || dist < 1e-5)
        return vec2(0.0);

    vec2  dir      = offset / dist;
    float strength = 1.0 - dist / mouseForceRadius;
    return dir * strength * mouseForceStrength;
}



vec2 calculatePressureForce(uint i)
{
    vec2  force  = vec2(0.0);
    vec2  pos_i  = predPos[i];
    ivec2 base   = PositionToCellCoord(pos_i);

    for (int dy = -1; dy <= 1; dy++)
    {
        for (int dx = -1; dx <= 1; dx++)
        {
            ivec2 cell = base + ivec2(dx, dy);

            if (cell.x < 0 || cell.y < 0)               
                continue;

            if (cell.x >= int(gridWidth) || cell.y >= int(gridHeight))                
                continue;

            uint key   = uint(cell.x + cell.y * int(gridWidth));
            uint count = min(cellCounts[key], MAX_PARTICLES_PER_CELL);

            for (uint k = 0; k < count; k++)
            {
                uint j = cellParticles[key * MAX_PARTICLES_PER_CELL + k];

                if (j == i) 
                    continue;

                vec2  offset = predPos[j] - pos_i;
                float sqrDst = dot(offset, offset);

                if (sqrDst > smoothRadiusSq) 
                    continue;

                float dist = sqrt(sqrDst);

                if (dist < 1e-6) 
                    continue;

                vec2  dir           = offset / dist;
                float slope         = kernelDerivative(smoothRadius, dist);
                float sharedPressure = (pressures[i] + pressures[j]) * 0.5;
                if (densities[j] < 0.0001) 
                    continue;
                force += sharedPressure * dir * slope / densities[j];
            }
        }
    }

    return force;
}



vec2 calculateViscosityForce(uint i)
{
    vec2  force = vec2(0.0);
    vec2  pos_i = predPos[i];
    vec2  vel_i = particles[i].velocity;
    ivec2 base  = PositionToCellCoord(pos_i);

    for (int dy = -1; dy <= 1; dy++)
    {
        for (int dx = -1; dx <= 1; dx++)
        {
            ivec2 cell = base + ivec2(dx, dy);

            if (cell.x < 0 || cell.y < 0)               
                continue;
            if (cell.x >= int(gridWidth) || cell.y >= int(gridHeight))                
                continue;

            uint key   = uint(cell.x + cell.y * int(gridWidth));
            uint count = min(cellCounts[key], MAX_PARTICLES_PER_CELL);

            for (uint k = 0; k < count; k++)
            {
                uint j = cellParticles[key * MAX_PARTICLES_PER_CELL + k];

                if (j == i) // no self interaction in viscosity
                    continue;

                vec2  offset = predPos[j] - pos_i;
                float sqrDst = dot(offset, offset);

                if (sqrDst > smoothRadiusSq) 
                    continue;

                float dist = sqrt(sqrDst);
                if (dist < 1e-6) 
                    continue;

                vec2  velDiff   = particles[j].velocity - vel_i;
                float influence = kernel(smoothRadius, dist);

                force += velDiff * influence;
            }
        }
    }
    return clamp(viscosityStrength * force, vec2(-9.999), vec2(9.999)); // clamped because of the "bubble" forming bug (at least it does not cause explosion now)
    //return viscosityStrength * force;
    
}



void main()
{
    uint id = gl_GlobalInvocationID.x;
    if (id >= particleCount) 
        return;

    particles[id].velocity += gravity * dt;
    particles[id].velocity += calculateMouseForce(id) * dt;

    float density = max(densities[id], 0.0001);
    particles[id].velocity += calculatePressureForce(id) / density * dt;
    particles[id].velocity += calculateViscosityForce(id) * dt;

    particles[id].position += particles[id].velocity * dt;

    // Boundary collisions
    if (particles[id].position.x < -1.0) {
        particles[id].position.x  = -1.0;
        particles[id].velocity.x *= -dampening;
    }
    if (particles[id].position.x >  1.0) {
        particles[id].position.x  =  1.0;
        particles[id].velocity.x *= -dampening;
    }
    if (particles[id].position.y < -1.0) {
        particles[id].position.y  = -1.0;
        particles[id].velocity.y *= -dampening;
    }
    if (particles[id].position.y >  1.0) {
        particles[id].position.y  =  1.0;
        particles[id].velocity.y *= -dampening;
    }
}